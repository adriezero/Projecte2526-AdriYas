generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model administrador {
  ID               Int                  @id @default(autoincrement())
  Nombre           String               @db.VarChar(50)
  Email            String?              @db.VarChar(50)
  Permisos         String?              @db.VarChar(255)
  Contrase_a       String               @map("Contraseña") @db.VarChar(60)
  Estado           administrador_Estado @default(Disponible)
  resetToken       String?              @unique
  resetTokenExpiry DateTime?
  comentarios      comentarios[]
  rol              rol[]
}

model camionero {
  ID                Int                 @id @default(autoincrement())
  Nombre            String              @db.VarChar(50)
  Email             String?             @db.VarChar(50)
  Licencia          camionero_Licencia
  Telf              String              @db.VarChar(10)
  Disponible        Boolean             @default(true)
  idTurno           Int
  FechaInicio       DateTime            @db.Date
  FechaFinal        DateTime            @db.Date
  Contrase_a        String              @default("temp_password") @map("Contraseña") @db.VarChar(60)
  resetToken        String?             @unique
  resetTokenExpiry  DateTime?
  turnos            turnos              @relation(fields: [idTurno], references: [ID], onDelete: Cascade)
  rutas             rutas[]
  solicitud_reserva solicitud_reserva[]

  @@index([idTurno])
}

model cliente {
  ID                Int                  @id @default(autoincrement())
  Nombre            String               @db.VarChar(50)
  NombreEmpresa     String               @db.VarChar(150)
  RazonSocial       String?              @db.VarChar(255)
  Email             String?              @db.VarChar(50)
  Contrase_a        String               @map("Contraseña") @db.VarChar(60)
  Telf              String               @db.VarChar(10)
  EstadoCuenta      cliente_EstadoCuenta @default(Disponible)
  resetToken        String?              @unique
  resetTokenExpiry  DateTime?
  comentarios       comentarios[]
  informes          informes[]
  solicitud_reserva solicitud_reserva[]
}

model comentarios {
  ID            Int            @id @default(autoincrement())
  Contenido     String?        @db.VarChar(200)
  EsPositivo    Boolean        @default(true)
  Fecha         DateTime       @default(now())
  Moderado      Boolean?       @default(false)
  Administrador Int?
  Ruta          Int
  Cliente       Int
  administrador administrador? @relation(fields: [Administrador], references: [ID], onDelete: Cascade)
  cliente       cliente        @relation(fields: [Cliente], references: [ID], onDelete: Cascade)
  rutas         rutas          @relation(fields: [Ruta], references: [ID], onDelete: Cascade)

  @@index([Administrador])
  @@index([Ruta])
  @@index([Cliente])
}

model dispatcher {
  ID               Int          @id @default(autoincrement())
  Nombre           String       @db.VarChar(50)
  Email            String       @db.VarChar(50)
  Contrase_a       String       @map("Contraseña") @db.VarChar(60)
  CentroOperacion  String?      @db.VarChar(255)
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  documentos       documentos[]
  informes         informes[]
}

model documentos {
  ID          Int                    @id @default(autoincrement())
  Nombre      String                 @db.VarChar(255)
  FechaSubida DateTime               @default(now())
  Dispatcher  Int?
  Tipo        documentos_Tipo
  AsociadoA   String?                @db.VarChar(255)
  Tamano      String?                @db.VarChar(20)
  RutaArchivo String                 @db.VarChar(500)
  Descripcion String?                @db.VarChar(500)
  SubidoPor   Int?
  RolSubidor  documentos_RolSubidor?
  createdAt   DateTime?              @default(now())
  updatedAt   DateTime               @default(now()) @updatedAt
  idRuta      Int?
  dispatcher  dispatcher?            @relation(fields: [Dispatcher], references: [ID], onDelete: Cascade)
  rutas       rutas?                 @relation(fields: [idRuta], references: [ID], onDelete: Cascade)

  @@index([Dispatcher])
  @@index([FechaSubida])
  @@index([Tipo])
  @@index([idRuta])
}

model informes {
  ID           Int               @id @default(autoincrement())
  Tipo         String            @db.VarChar(50)
  Formato      informes_Formato?
  FechaSubida  DateTime          @db.Date
  idDispatcher Int
  idCliente    Int
  cliente      cliente           @relation(fields: [idCliente], references: [ID], onDelete: Cascade)
  dispatcher   dispatcher        @relation(fields: [idDispatcher], references: [ID], onDelete: Cascade)

  @@index([idDispatcher])
  @@index([idCliente])
}

model reservas {
  ID                Int                 @id @default(autoincrement())
  Fecha             DateTime            @db.Date
  Motivo            String              @db.VarChar(150)
  Descripci_n       String?             @map("Descripción") @db.VarChar(255)
  solicitud_reserva solicitud_reserva[]
}

model rol {
  ID            Int           @id @default(autoincrement())
  Nombre        String        @db.VarChar(50)
  Descripci_n   String?       @map("Descripción") @db.VarChar(150)
  idAdmin       Int
  administrador administrador @relation(fields: [idAdmin], references: [ID], onDelete: Cascade)

  @@index([idAdmin])
}

model rutas {
  ID           Int           @id @default(autoincrement())
  Estado       rutas_Estado?
  Reservas     String
  Cargas       String
  EnTiempoReal Boolean       @default(false)
  Camionero    Int
  Origen       String        @db.VarChar(255)
  Destino      String        @db.VarChar(255)
  FechaInicio  DateTime      @default(now()) @db.Date
  comentarios  comentarios[]
  documentos   documentos[]
  camionero    camionero     @relation(fields: [Camionero], references: [ID], onDelete: Cascade)

  @@index([Camionero])
}

model solicitud_reserva {
  idReserva   Int
  idCliente   Int
  idCamionero Int
  camionero   camionero @relation(fields: [idCamionero], references: [ID], onUpdate: Restrict)
  cliente     cliente   @relation(fields: [idCliente], references: [ID], onUpdate: Restrict)
  reservas    reservas  @relation(fields: [idReserva], references: [ID], onUpdate: Restrict)

  @@id([idReserva, idCliente])
  @@index([idCamionero])
  @@index([idCliente])
  @@index([idReserva])
}

model turnos {
  ID          Int         @id @default(autoincrement())
  Descripci_n String      @map("Descripción") @db.VarChar(255)
  camionero   camionero[]
}

model reportes {
  ID            Int             @id @default(autoincrement())
  Tipo          reportes_Tipo
  FechaHora     DateTime        @default(now())
  Estado        reportes_Estado @default(Pendiente)
  idReportante  Int
  rolReportante reportes_Rol
  Descripcion   String?
}

enum rutas_Estado {
  Programado
  Cargando
  En_ruta
  En_pausa
  Finalizado
  Incidente
}

enum informes_Formato {
  CSV
  PDF
}

enum camionero_Licencia {
  A
  B
  C
  C1
  CE
  D
  E
}

enum administrador_Estado {
  Disponible
  Ocupado
  No_molestar @map("No molestar")
  Ausente
  D_a_libre   @map("Día libre")
}

enum cliente_EstadoCuenta {
  Disponible
  Ocupado
  No_molestar @map("No molestar")
  Ausente
  D_a_libre   @map("Día libre")
}

enum reportes_Estado {
  Pendiente
  En_revisi_n @map("En revisión")
  Resuelto
  Cerrado
}

enum reportes_Rol {
  Administrador
  Camionero
  Cliente
  Dispatcher
}

enum reportes_Tipo {
  Problema_T_cnico @map("Problema Técnico")
  Incidencia
  Sugerencia
}

enum documentos_RolSubidor {
  Administrador
  Dispatcher
  Camionero
  Cliente
}

enum documentos_Tipo {
  Factura
  Contrato
  Permiso
  Seguro
  Licencia
  Certificado
  Otro
}
